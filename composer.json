    "type": "magento2-module",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "magento/framework": ">=103.0",
        "magento/module-payment": "*",
        "magento/module-sales": "*",
        "magento/module-checkout": "*",
        "magento/module-quote": "*"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": { "ArionPay\\Payment\\": "" }
    }
}
