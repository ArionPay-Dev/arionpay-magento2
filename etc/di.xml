<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="ArionPayFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="const">ArionPay\Payment\Model\Config::CODE</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Magento\Payment\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">ArionPayValueHandlerPool</argument>
            <argument name="validatorPool" xsi:type="object">ArionPayValidatorPool</argument>
            <argument name="commandPool" xsi:type="object">ArionPayCommandPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="ArionPayGatewayConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">ArionPay\Payment\Model\Config::CODE</argument>
        </arguments>
    </virtualType>
    <virtualType name="ArionPayConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">ArionPayGatewayConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="ArionPayValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">ArionPayConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="ArionPayCountryValidator" type="Magento\Payment\Gateway\Validator\CountryValidator">
        <arguments>
            <argument name="config" xsi:type="object">ArionPayGatewayConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="ArionPayValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="country" xsi:type="string">ArionPayCountryValidator</item>
                <item name="currency" xsi:type="string">ArionPay\Payment\Gateway\Validator\CurrencyValidator</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="ArionPayCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="initialize" xsi:type="string">ArionPay\Payment\Gateway\Command\InitializeCommand</item>
            </argument>
        </arguments>
    </virtualType>
</config>
